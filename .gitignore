# 工具链产物（体积大，可由 build_runtime.py / build.sh 重新生成）
desktop_app/runtime/
desktop_app/LocalNotes.app/
desktop_app/.build-*
desktop_app/*.iconset/

# 说明：dist/*.dmg 是要发布的安装包，故意不做忽略
